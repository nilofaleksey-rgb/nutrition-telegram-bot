# Скопируйте в .env для локального запуска. На Amvera задайте те же имена в панели переменных.

# --- обязательно ---
BOT_TOKEN=                    # токен от @BotFather
DB_PATH=data/bot.db           # на Amvera: /data/bot.db
TIMEZONE=Europe/Moscow

# --- ИИ: GigaChat (основной, работает из России, бесплатная квота для физлиц) ---
GIGACHAT_AUTH_KEY=            # «Авторизационные данные» (base64) из кабинета developers.sber.ru
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2     # текст: консультации, советы, ужин
GIGACHAT_VISION_MODEL=GigaChat-2-Max   # фото и анализы (проверьте в кабинете, что модель доступна)
GIGACHAT_CA_CERT=certs/russian_trusted_root_ca.pem   # сертификат Минцифры (см. docs/SETUP_RU.md)
GIGACHAT_VERIFY_SSL=true      # false — только для отладки, небезопасно

# --- ИИ: OpenAI (запасной, если GigaChat не задан) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
