# Скопируйте в .env для локального запуска (или задайте те же переменные в панели Amvera)
BOT_TOKEN=               # токен от @BotFather (обязательно)
OPENAI_API_KEY=          # ключ OpenAI (нужен для фото, голоса, консультаций и анализов)
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
DB_PATH=data/bot.db      # на Amvera: /data/bot.db
TIMEZONE=Europe/Moscow
