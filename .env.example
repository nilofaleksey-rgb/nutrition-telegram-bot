# Переменные окружения

# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=

# Бесплатный ключ Google Gemini — нужен для анализа фото, распознавания голоса
# и умных развёрнутых ответов. Получить без карты: https://aistudio.google.com/apikey
# Если ключ не задан — бот всё равно работает: распознавание еды по тексту,
# дневник, КБЖУ и рекомендации считаются бесплатным AI без ключа и локальной базой.
GEMINI_API_KEY=

# Опционально: конкретная модель Gemini (по умолчанию подбирается автоматически)
# GEMINI_MODEL=gemini-2.5-flash

# Путь к файлу базы данных
DATABASE_PATH=./data/nutrition.db